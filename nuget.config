<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Local test packages: drop a .nupkg into ./local-packages (e.g. the CI
         PR artifact) and reference it by its exact version. The path is
         relative to this file, so it works on any machine that clones the repo. -->
    <add key="local" value="./local-packages" />
  </packageSources>
</configuration>
